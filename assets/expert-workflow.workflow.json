    { "id": "jdmatch", "lane": "expB", "col": 2, "type": "backend", "label": "岗位匹配专家", "sublabel": "匹配度 · 补强路线", "tag": "需 JD · 并行", "width": 120 },
    { "id": "ability", "lane": "expA", "col": 3, "type": "backend", "label": "能力透视专家", "sublabel": "雷达 · 竞争力 · 风险", "tag": "并行", "width": 120 },
    { "id": "report", "lane": "expA", "col": 5, "type": "backend", "label": "可视化报告专家", "sublabel": "双 JSON → HTML", "tag": "串行收尾", "width": 110 },
    { "id": "preview", "lane": "ui", "col": 5, "type": "frontend", "label": "预览 + 导出", "sublabel": "iframe · 导出 HTML" }
